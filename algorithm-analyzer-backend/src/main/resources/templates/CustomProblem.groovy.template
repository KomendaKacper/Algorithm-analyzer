/**
 * A simple "OneMax" problem template.
 * Goal: Maximize the number of "1"s in a binary string.
 * Supports Local Search and Evolutionary algorithms.
 */
public class MyCustomProblem extends AbstractProblem {

    private final Random random = new Random()
    private int bitStringLength = 10; // Default value
    private List<String> elements = ["0", "1"] // All possible elements

    // --- 1. Basic Info ---
    
    @Override
    public String getName() { return "My Custom OneMax Problem" }

    @Override
    public String getDescription() { return "Custom problem: Maximize the number of '1's in a binary string." }

    @Override
    public boolean isMaximization() { return true }

    // --- 2. Parameters & Initialization ---
    
    @Override
    public List<ParameterDefinition> getParameters() {
        return Arrays.asList(
            new ParameterDefinition(
                "length", "Bit String Length", ParameterType.INTEGER, 
                20, 5, 1000, "The length of the binary string.", true
            )
        )
    }

    @Override
    public void initialize(Map<String, Object> parameters) {
        // Use the helper method from AbstractProblem
        this.bitStringLength = (Integer) getParameter(parameters, "length", 20)
        this.initialized = true
    }

    // --- 3. Core Logic ---

    @Override
    public double evaluateSolution(List<String> solution) {
        checkInitialized()
        if (solution == null) return 0.0
        // The score is simply the count of "1"s
        return solution.stream().filter(bit -> bit.equals("1")).count()
    }

    @Override
    public boolean isValidSolution(List<String> solution) {
        // In this simple problem, all solutions of the correct length are valid
        return solution != null && solution.size() == this.bitStringLength
    }

    @Override
    public List<String> getAllElements() {
        // This is tricky for OneMax. We'll return the indices as strings.
        List<String> indices = new ArrayList<>()
        for (int i = 0; i < bitStringLength; i++) {
            indices.add(String.valueOf(i))
        }
        return indices
    }

    // --- 4. Methods for Local Search (SA, TS, Custom Random Walk) ---
    
    @Override
    public List<String> generateRandomSolution() {
        checkInitialized()
        List<String> solution = new ArrayList<>()
        for (int i = 0; i < this.bitStringLength; i++) {
            solution.add(random.nextBoolean() ? "1" : "0")
        }
        return solution
    }
    
    @Override
    public List<String> mutate(List<String> solution) {
        checkInitialized()
        List<String> neighbor = new ArrayList<>(solution)
        if (neighbor.isEmpty()) return neighbor

        // Flip one random bit
        int indexToFlip = random.nextInt(this.bitStringLength)
        String currentBit = neighbor.get(indexToFlip)
        neighbor.set(indexToFlip, currentBit.equals("1") ? "0" : "1")
        
        return neighbor
    }

    // --- 5. Methods for other algorithm types (NOT IMPLEMENTED) ---
    // We must provide implementations, even if they are empty/throw errors,
    // to satisfy the 'Problem' interface contract.
    
    @Override
    public List<String> generateNeighborSolution(List<String> currentSolution) {
        // For this problem, mutate() is the neighbor function
        return mutate(currentSolution)
    }

    @Override
    public List<String> crossover(List<String> parent1, List<String> parent2) {
        // Standard one-point crossover
        checkInitialized()
        int crossoverPoint = random.nextInt(this.bitStringLength)
        List<String> child = new ArrayList<>()
        for (int i = 0; i < this.bitStringLength; i++) {
            child.add(i < crossoverPoint ? parent1.get(i) : parent2.get(i))
        }
        return child
    }

    // --- 6. Unused methods (can be empty/default) ---

    @Override
    public Map<String, Object> getProblemData() { return Map.of() }

    @Override
    public List<String> getPossibleNextElements(String current, List<String> visited) { 
        // Not applicable for this problem type
        return Collections.emptyList()
    }
    
    @Override
    public boolean isSolutionComplete(List<String> path) {
        // Not applicable
        return true
    }

    @Override
    public double getHeuristicValue(String from, String to) { 
        // Not applicable
        return 1.0 
    }
    
    @Override
    public String getStartElement() { 
        // Not applicable
        return null 
    }
    
    @Override
    public List<String> convertPathToSolution(List<String> path) { 
        // This problem doesn't use paths, the solution *is* the path
        return path
    }
}